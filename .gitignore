# Gradle
.gradle/
build/
*/build/
local.properties

# IDE
.idea/
*.iml
.DS_Store
captures/

# Native
.cxx/
*.so
# BUT the bundled proot runtime MUST be committed (packaged as jniLibs;
# Android 10+ forbids exec from app data, so they ship inside the APK):
!app/src/main/jniLibs/**/*.so

# Bootstrap staging (large artifacts are produced by scripts/build-rootfs.sh)
linux-runtime/bootstrap/**/rootfs.tar.*
linux-runtime/bootstrap/**/proot
linux-runtime/bootstrap/**/*.sha256.staged

# Runtime logs
*.log

# Python bytecode
__pycache__/
*.pyc
site/
