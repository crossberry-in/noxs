#!/bin/bash
# noxs-welcome.sh — the Noxs welcome dashboard (interactive shells).
# Installed at /usr/local/lib/noxs-welcome.sh by RootfsConfigurator. The
# bashrc snippet owns the "interactive only, once per session tree" guard
# (NOXS_BANNER_SHOWN + [ -t 1 ]) and sources this file; it only defines the
# renderer so it can be called (and tested) directly.
#
# Pure shell, zero dependencies, real facts only: /etc/os-release PRETTY_NAME,
# uname -m / -r and the session user. NO_COLOR or TERM=dumb disables all
# color; dumb terminals also get ASCII borders; narrow columns get a compact
# two-line fallback. Every padded string is plain ASCII, so border alignment
# never depends on locale byte/char counting.

# ---- row helpers (widths come from _NX_W/_NX_H/_NX_V set by noxs_welcome)

_nx_welcome_bar() { # <top-left> <top-right>
    local out="" i=0
    while [ "$i" -lt "$(($_NX_W - 2))" ]; do out="$out$_NX_H"; i=$((i + 1)); done
    printf '%s%s%s\n' "$1" "$out" "$2"
}

_nx_welcome_row() { # <color> <plain ascii content>
    local content="$2" pad sp
    if [ "${#content}" -gt "$(($_NX_W - 4))" ]; then
        content="${content:0:$(($_NX_W - 4))}"
    fi
    pad=$(($_NX_W - ${#content} - 4))
    [ "$pad" -lt 0 ] && pad=0
    printf -v sp '%*s' "$pad" ''
    printf '%s %s%s%s%s %s\n' "$_NX_V" "$1" "$content" "$_NX_R" "$sp" "$_NX_V"
}

_nx_welcome_qs() { # <command> <description>
    local cpad desc_max desc="$2" pad sp
    printf -v cpad '%-18s' "$1"
    desc_max=$(($_NX_W - 22))
    if [ "${#desc}" -gt "$desc_max" ]; then desc="${desc:0:$desc_max}"; fi
    pad=$(($_NX_W - 18 - ${#desc} - 4))
    [ "$pad" -lt 0 ] && pad=0
    printf -v sp '%*s' "$pad" ''
    printf '%s %s%s%s%s%s%s %s\n' \
        "$_NX_V" "$_NX_C" "$cpad" "$_NX_R$_NX_D" "$desc" "$_NX_R" "$sp" "$_NX_V"
}

_nx_welcome_title() {
    local content="Noxs Linux" pad sp
    pad=$(($_NX_W - ${#content} - 6))
    [ "$pad" -lt 0 ] && pad=0
    printf -v sp '%*s' "$pad" ''
    printf '%s%s ● %s%s%s%s %s\n' "$_NX_V" "$_NX_G" "$_NX_B" "$content" "$_NX_R" "$sp" "$_NX_V"
}

noxs_welcome() {
    # ---- real facts (never fabricated) ------------------------------------
    local os_file="${1:-/etc/os-release}" pretty="" arch kern user
    if [ -r "$os_file" ]; then
        pretty="$(. "$os_file" 2>/dev/null; printf '%s' "${PRETTY_NAME:-}")"
    fi
    [ -n "$pretty" ] || pretty="Linux"
    arch="$(uname -m 2>/dev/null || printf 'unknown')"
    kern="$(uname -r 2>/dev/null || printf 'unknown')"
    user="${USER:-$(id -un 2>/dev/null || printf 'noxs')}"


    # ---- palette: NO_COLOR / dumb terminals get plain text -----------------
    local _NX_G='' _NX_C='' _NX_D='' _NX_B='' _NX_R=''
    if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
        local E
        E=$(printf '\033')
        _NX_G="${E}[1;32m" _NX_C="${E}[36m" _NX_D="${E}[2m"
        _NX_B="${E}[1m" _NX_R="${E}[0m"
    fi
    # ---- borders: Unicode box, ASCII for dumb terminals --------------------
    local _NX_H _NX_V _NX_W TL TR BL BR SEP SEPR
    if [ "${TERM:-}" = "dumb" ]; then
        _NX_H='-' _NX_V='|' TL='+' TR='+' BL='+' BR='+' SEP='+' SEPR='+'
    else
        _NX_H='─' _NX_V='│' TL='┌' TR='┐' BL='└' BR='┘' SEP='├' SEPR='┤'
    fi

    # ---- width: real columns, clamped (mobile-first) -----------------------
    _NX_W=${COLUMNS:-56}
    case "$_NX_W" in (*[!0-9]*|"") _NX_W=56 ;; esac
    [ "$_NX_W" -lt 10 ] && _NX_W=56
    [ "$_NX_W" -gt 68 ] && _NX_W=68

    # ---- narrow screens: compact fallback, no box ---------------------------
    if [ "$_NX_W" -lt 34 ]; then
        printf '%s● Noxs Linux%s — %s · %s · %s\n' \
            "$_NX_B$_NX_G" "$_NX_R" "$pretty" "$arch" "$user"
        printf '%snoxs help%s · %snx plug%s · %snx cert-fix%s\n' \
            "$_NX_C" "$_NX_R" "$_NX_C" "$_NX_R" "$_NX_C" "$_NX_R"
        return 0
    fi

    _nx_welcome_bar "$TL" "$TR"
    _nx_welcome_title
    _nx_welcome_row "$_NX_D" "by CrossberryWeb | $pretty"
    _nx_welcome_row "$_NX_D" "$arch | kernel $kern | user $user"
    _nx_welcome_bar "$SEP" "$SEPR"
    _nx_welcome_row "$_NX_B" "Quick Start"
    _nx_welcome_qs "noxs help" "all Noxs commands"
    _nx_welcome_qs "nx plug" "Plugin Store"
    _nx_welcome_qs "noxs code status" "VS Code editor"
    _nx_welcome_qs "nx cert-fix" "repair APT / certificates"
    _nx_welcome_qs "sudo apt update" "refresh package metadata"
    _nx_welcome_bar "$SEP" "$SEPR"
    _nx_welcome_row "$_NX_D" "crossberry.vercel.app | crossberryweb@gmail.com"
    _nx_welcome_bar "$BL" "$BR"
}
