            err "no help topic: $topic (try: noxs help)"
            exit 2
            ;;
    esac
}

case "${1:-help}" in
    help|--help|-h)
        shift
        do_help "${1:-}"
        ;;
    docs)
        shift
        docs_command "$@"
        ;;
    version|--version)
        do_version
        ;;
    code)
        case "${2:-status}" in
            install) shift 2; code_install "$@" ;;
            start)   shift 2; code_start "$@" ;;
            stop)    code_stop ;;
            restart) shift 2; code_stop; code_start "$@" ;;
            status)  if [ "${3:-}" = "--json" ]; then code_status_json; else code_status; fi ;;
            logs)    shift 2; code_logs "$@" ;;
            *) err "usage: noxs code install|start|stop|restart|status [--json]|logs"; exit 2 ;;
        esac
        ;;
    storage)
        shift
        storage_command "$@"
        ;;
    files)
        shift
        files_command "$@"
        ;;
    document)
        shift
        document_command "$@"
        ;;
    sms)
        shift
        sms_command "$@"
        ;;
    device)
        shift
        device_command "$@"
        ;;
    notification)
        shift
        notification_command "$@"
        ;;
    share)
        shift
        share_command "$@"
        ;;
    camera)
        shift
        camera_command "$@"
        ;;
    clipboard)
        shift
        clipboard_command "$@"
        ;;
    network)
        shift
        network_command "$@"
        ;;
    docker)
        case "${2:-status}" in
            install) docker_install ;;
            start)   docker_start ;;
            stop)    docker_stop ;;
            restart) docker_stop; docker_start ;;
            status)  docker_status ;;
            info)    docker_info ;;
            test)    docker_test ;;
            *) err "usage: noxs docker install|start|stop|restart|status|info|test"; exit 2 ;;
        esac
        ;;
    info) do_info ;;
    status) do_status ;;
    update) do_update ;;
    ubuntu)
        case "${2:-status}" in
            status) do_ubuntu_status ;;
            *) err "usage: noxs ubuntu status"; exit 2 ;;
        esac
        ;;
    *)
        # Unknown command: suggest the closest valid entry points + docs URL.
        err "unknown command: $1 (try: noxs help)"
        err "or run: noxs help | noxs docs  —  docs: $NOXS_DOCS_BASE/"
        exit 2
        ;;
esac
