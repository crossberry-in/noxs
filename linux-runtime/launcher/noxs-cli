docs_command() {
    local topic="${1:-}" url
    if [ "$topic" = "help" ] || [ "$topic" = "--help" ] || [ "$topic" = "-h" ]; then
        printf 'Usage: noxs docs [topic]\nOpens the matching page on the Noxs documentation site and prints\nthe URL. Without a topic it opens the documentation home.\n\nTopics:\n  '
        docs_topics
        printf '  aliases: nx, commands, pkg, apt, plugins, plugin-sdk, file-manager, vpn\n\nDocumentation: %s/\n' "$NOXS_DOCS_BASE"
        return 0
    fi
    if ! url="$(docs_url "$topic")"; then
        err "unknown docs topic: $topic (valid topics below)"
        printf '  ' >&2
        docs_topics >&2
        err "base documentation URL: $NOXS_DOCS_BASE/"
        return 2
    fi
    # Try the Android browser through the bridge; the URL is ALWAYS printed
    # somewhere (bridge reply or the fallback line below), so the command
    # works even when no browser is reachable.
    if bridge_request open-url "$url"; then
        return 0
    fi
    printf 'Documentation: %s\n' "$url"
}

