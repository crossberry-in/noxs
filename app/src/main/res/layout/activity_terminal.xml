<?xml version="1.0" encoding="utf-8"?>
<!--
  Noxs main terminal screen.
  Section order: application header → session selector → terminal action
  toolbar → terminal output (max height) → extra keys. The drawer is a plain
  scrollable column: compact header, session list, uniform icon navigation.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/noxs_background">

    <!-- Main terminal column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/noxs_background">

        <!-- A. Application header -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@color/noxs_panel">

            <TextView
                android:id="@+id/btn_drawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_menu"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/noxs_text"
                android:textSize="17sp" />

            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"
                android:background="@color/noxs_accent" />

            <TextView
                android:id="@+id/status_session"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxWidth="110dp"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status_state"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/status_proc_desc"
                android:text=""
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/status_cpu"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU 0%"
                android:textColor="@color/noxs_text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_mem"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="96dp"
                android:singleLine="true"
                android:text="MEM 0 MB"
                android:textColor="@color/noxs_text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_header_more"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/header_more"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/noxs_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Expandable secondary statistics (hidden by default) -->
        <LinearLayout
            android:id="@+id/stats_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:background="@color/noxs_panel"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_proc"
                style="@style/Text.Noxs.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/status_proc_desc"
                android:text=""
                android:textColor="@color/noxs_text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_storage"
                style="@style/Text.Noxs.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 MB"
                android:textColor="@color/noxs_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/noxs_border" />

        <!-- B. Session selector -->
        <HorizontalScrollView
            android:id="@+id/session_tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scrollbars="none"
            android:background="@color/noxs_background"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/session_tabs_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <!-- C. Terminal action toolbar: primary actions + overflow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/noxs_border" />

        <HorizontalScrollView
            android:id="@+id/actions_scroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scrollbars="none"
            android:background="@color/noxs_panel"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/actions_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/btn_action_new_shell"
                    style="@style/Text.Noxs.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_accent"
                    android:text="@string/action_new_shell"
                    android:textColor="@color/noxs_on_accent" />

                <TextView
                    android:id="@+id/btn_action_new_root"
                    style="@style/Text.Noxs.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:text="@string/action_new_root"
                    android:textColor="@color/noxs_warning" />

                <TextView
                    android:id="@+id/btn_action_activity"
                    style="@style/Text.Noxs.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:text="@string/action_center"
                    android:textColor="@color/noxs_text" />

                <TextView
                    android:id="@+id/btn_action_copy"
                    style="@style/Text.Noxs.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:text="@string/action_copy"
                    android:textColor="@color/noxs_text" />

                <TextView
                    android:id="@+id/btn_action_paste"
                    style="@style/Text.Noxs.PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:text="@string/action_paste"
                    android:textColor="@color/noxs_text" />

                <TextView
                    android:id="@+id/btn_action_more"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_more"
                    android:gravity="center"
                    android:text="⋮"
                    android:textColor="@color/noxs_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/noxs_border" />

        <!-- D. Interactive terminal canvas: IME input goes directly to the PTY -->
        <FrameLayout
            android:id="@+id/terminal_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/noxs_background">

            <com.crossberry.noxs.terminal.view.TerminalView
                android:id="@+id/terminal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Output search bar (hidden until Search is tapped) -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/noxs_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/terminal_search_hint"
                    android:fontFamily="monospace"
                    android:hint="@string/terminal_search_hint"
                    android:imeOptions="actionSearch|flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/noxs_text"
                    android:textColorHint="@color/noxs_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_search_count"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text=""
                    android:textColor="@color/noxs_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_search_prev"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_search_prev"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_next"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_search_next"
                    android:gravity="center"
                    android:text="↓"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_close"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_close"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/noxs_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_terminal_latest"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="14dp"
                android:backgroundTint="@color/noxs_accent"
                android:contentDescription="@string/terminal_latest"
                android:elevation="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/terminal_latest"
                android:textAllCaps="false"
                android:textColor="@color/noxs_on_accent"
                android:visibility="gone"
                app:cornerRadius="20dp" />

        </FrameLayout>

        <!-- E. Extra keyboard row -->
        <com.crossberry.noxs.terminal.view.NoxsExtraKeysBar
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </LinearLayout>

    <!-- Navigation drawer: flexible scrolling column -->
    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:background="@color/noxs_nav">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Drawer header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/app_name"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/app_name"
                        android:textColor="@color/noxs_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sessions section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/drawer_sessions"
                    android:textColor="@color/noxs_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/btn_new_session"
                        style="@style/Text.Noxs.PillButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_accent"
                        android:text="@string/drawer_new_shell"
                        android:textColor="@color/noxs_on_accent" />

                    <TextView
                        android:id="@+id/btn_new_root"
                        style="@style/Text.Noxs.PillButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill"
                        android:text="@string/drawer_new_root"
                        android:textColor="@color/noxs_warning" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/session_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/noxs_border" />

                <!-- Navigation items (uniform 48dp rows) -->
                <LinearLayout
                    android:id="@+id/nav_terminal"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_terminal" android:contentDescription="@string/nav_terminal" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_terminal" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_files"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_files" android:contentDescription="@string/nav_files" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_files" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_editor"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_editor" android:contentDescription="@string/nav_editor" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_editor" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_plugins"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_plugins" android:contentDescription="@string/nav_plugins" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_plugins" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_packages"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_packages" android:contentDescription="@string/nav_packages" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_packages" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_users"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_users" android:contentDescription="@string/nav_users" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_users" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_activity"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_activity" android:contentDescription="@string/nav_activity_center" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_activity_center" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_processes"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_processes" android:contentDescription="@string/nav_processes" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_processes" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_services"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_services" android:contentDescription="@string/nav_services" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_services" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_env"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_env" android:contentDescription="@string/nav_env" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_env" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_storage"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_storage" android:contentDescription="@string/nav_storage" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_storage" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_security"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_security" android:contentDescription="@string/nav_security" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_security" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_settings"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_settings" android:contentDescription="@string/nav_settings" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_settings" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_diagnostics"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_diagnostics" android:contentDescription="@string/nav_diagnostics" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_diagnostics" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_about"
                    style="@style/Text.Noxs.NavRow">
                    <ImageView style="@style/Text.Noxs.NavIcon" android:src="@drawable/ic_nav_about" android:contentDescription="@string/nav_about" />
                    <TextView style="@style/Text.Noxs.NavLabel" android:text="@string/nav_about" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
