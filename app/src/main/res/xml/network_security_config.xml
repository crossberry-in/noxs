<?xml version="1.0" encoding="utf-8"?>
<!--
  Noxs network security policy.

  Cleartext HTTP stays disabled everywhere EXCEPT the device loopback, where
  the Noxs Linux guest serves the code-server editor for the built-in editor
  screen. The guest shares the device network namespace (proot does not
  create one), so 127.0.0.1 here is exactly the server's bind address.
  Nothing else may travel over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
