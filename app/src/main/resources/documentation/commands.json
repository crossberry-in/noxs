    {
      "name": "noxs storage",
      "category": "storage",
      "description": "SAF-backed Android storage access: status, per-category mapping, file operations, optional direct mount.",
      "usage": "noxs storage status|setup|map|repair|reset|ls|mkdir|cat|get|put|rm|cp|mv|permission|grant|revoke|mount|unmount|list",
      "arguments": [
        "category (shared, downloads, dcim, pictures, music, movies, documents)",
        "relative-path",
        "local-file"
      ],
      "options": [
        "grant --direct (Android all-files-access screen for the /sdcard mount)"
      ],
      "examples": [
        "noxs storage status",
        "noxs storage get downloads report.pdf ~/report.pdf",
        "noxs storage grant --direct"
      ],
      "implementation_status": "implemented",
      "platform_support": [
        "ubuntu"
      ],
      "documentation_route": "files/storage-access/"
    },
    {
      "name": "noxs-setup-storage",
      "category": "storage",
