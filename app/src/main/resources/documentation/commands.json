      "category": "general",
      "description": "Command reference; detailed page per topic (storage, device, code, pkg, plug, cert-fix, ai, docs, ...).",
      "usage": "noxs help [topic]",
      "arguments": [
        "topic (optional)"
      ],
      "options": [],
      "examples": [
        "noxs help",
        "noxs help storage"
      ],
      "implementation_status": "implemented",
      "platform_support": [
        "ubuntu"
      ],
      "documentation_route": "getting-started/quick-start/"
    },
