{
  "schema": "noxs.commands/1.0",
  "description": "Single source of truth for every Noxs CLI command. Generated help and documentation coverage tests read this file. Only commands that exist in the source (linux-runtime/launcher, NoxsCliTemplate, NoxsNxTemplate) are listed. documentation_route values are verified against the deployed nxos-docs GitHub Pages sitemap.",
  "docs_base": "https://crossberry-in.github.io/nxos-docs/",
  "commands": [
